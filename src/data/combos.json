{
  "//": "TODO(design): all numbers are working values. Times in seconds, distances in hexes.",
  "statuses": {
    "corroded": {
      "//": "Put on by the Acid Spitter: eats armor and hurts a little every second.",
      "displayName": "Corroded",
      "color": "#b7d13a",
      "durationSeconds": 6,
      "armorChange": -2,
      "damagePerSecond": 2,
      "speedMultiplier": 1
    },
    "soaked": {
      "//": "Put on by Mist clouds: people in the mist slow down. Wears off soon after they leave it.",
      "displayName": "Soaked",
      "color": "#6fb0c8",
      "durationSeconds": 1.5,
      "armorChange": 0,
      "damagePerSecond": 0,
      "speedMultiplier": 0.7
    }
  },
  "mistCloud": {
    "//": "Left by the Mist Breather where its attack lands. radius 1 = that hex and its six neighbours.",
    "radius": 1,
    "durationSeconds": 6,
    "appliesStatus": "soaked"
  },
  "combos": [
    {
      "id": "corrodeAndCrush",
      "displayName": "Corrode & Crush",
      "when": "headHitsEnemy",
      "conditions": { "attackTag": "bite", "enemyHasStatus": "corroded", "enemyArmorBroken": false },
      "effects": [
        { "type": "damage", "amount": 30 },
        { "type": "breakArmor" },
        { "type": "removeStatus", "status": "corroded" }
      ]
    },
    {
      "id": "acidFog",
      "displayName": "Acid Fog",
      "when": "headHitsEnemy",
      "conditions": { "attackTag": "acid", "enemyInMist": true },
      "effects": [
        { "type": "acidifyMist", "damagePerSecond": 3, "seconds": 5 }
      ]
    },
    {
      "id": "smother",
      "displayName": "Smother",
      "when": "enemyInMist",
      "conditions": { "enemyCarriesFire": true },
      "effects": [
        { "type": "putOutTorch", "seconds": 5 }
      ]
    }
  ]
}
